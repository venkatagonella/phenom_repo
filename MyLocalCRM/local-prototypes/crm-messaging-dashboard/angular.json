{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "crm-messaging-dashboard": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "dist/crm-messaging-dashboard",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/assets"],
            "styles": [
              "src/styles/pds-tokens.css",
              "src/styles/messaging-dashboard.css"
            ],
            "scripts": [],
            "extraWebpackConfig": "webpack.config.js",
            "commonChunk": false
          }
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "port": 4310,
            "publicHost": "http://localhost:4310",
            "extraWebpackConfig": "webpack.config.js"
          }
        }
      }
    }
  }
}
