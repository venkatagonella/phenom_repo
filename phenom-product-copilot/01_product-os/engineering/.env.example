# Copy to .env and fill in (never commit .env)
BITBUCKET_EMAIL=you@phenom.com
BITBUCKET_API_TOKEN=ATATT3x...

# Bitbucket Cloud REST API: use Basic auth with email + token
#   curl -u "$BITBUCKET_EMAIL:$BITBUCKET_API_TOKEN" https://api.bitbucket.org/2.0/user
# Git clone/pull: SSH (recommended) — HTTPS git does not accept this token alone
