# Phenom npm registry, needed to install the design system (@phenom/react-ds) and Font Awesome Pro
# in prototypes. Do not copy this file by hand: run
#
#   bash 01_product-os/onboarding/setup-npm.sh
#
# It writes these lines into ~/.npmrc (your user config, outside every repo) with your credentials.
# Credentials never go into this repo.

legacy-peer-deps=true
@phenom:registry=https://pie-nexus.phenompro.com/repository/pie-npm-group/
//pie-nexus.phenompro.com/repository/:_auth=<NEXUS_AUTH>

# Only if you have a Font Awesome Pro token:
@fortawesome:registry=https://npm.fontawesome.com/
@awesome.me:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=<FONTAWESOME_TOKEN>
