# =============================================================
# WHITELIST APPROACH — everything is ignored unless listed here
# =============================================================
# Two folders:
#   01_product-os/   the shared layer every PM pulls (tracked)
#   02_personal-os/  each PM's vault: system files tracked, everything you write stays local

# Ignore everything by default
*

# Allow directory traversal (git needs this to reach nested files)
!*/

# ---- Root files ----
!/.gitignore
!/.env.example
!/CLAUDE.md
!/README.md
!/.cursorignore
!/.rgignore
!/.cursor/**
!/.github/**
!/.claude/settings.json
!/.mcp.json

# ---- Product OS: the shared layer ----
!/01_product-os/**

# ---- Always ignore (even inside whitelisted folders) ----
.env
me.md
/.cursor/rules/**
.cursor/debug-*.log
/01_product-os/mcp/.cursor/mcp.json
**/node_modules/**
**/__pycache__/**
**/*.pyc
**/.DS_Store
**/*.zip
**/Icon?
**/*.local
**/package-lock.json

# Generated by 01_product-os/onboarding/build-catalog.mjs (rebuilt by /update-product-os)
/01_product-os/onboarding/data/**

# Raw ServiceNow / Jira exports and snapshots written by the SR and SUP theme scripts
# (ticket text, customer names, contact details). Only the masked HTML reports are shared.
/01_product-os/knowledge/servicenow-service-requests/data/
/01_product-os/knowledge/servicenow-service-requests/snapshot-*.json

# Clone cache only — do not use an unanchored `repos/` (that would hide
# engineering/index/repos/ manifests from git and ripgrep).
/01_product-os/engineering/repos/

# ---- Personal OS: your vault never leaves this laptop ----
# MUST STAY LAST. Everything under 02_personal-os/ is ignored, then only the system files
# every PM shares are re-included: rules, router files, scripts, templates and the
# empty folder structure. Notes, meetings, people, tasks, context, outputs/ and any
# file you add stay local. Never add a broader `!` rule here (e.g. a README.md glob
# would publish project READMEs).
/02_personal-os/**
!/02_personal-os/**/
!/02_personal-os/AGENTS.md
!/02_personal-os/CLAUDE.md
!/02_personal-os/README.md
!/02_personal-os/.cursor/rules/**
!/02_personal-os/99_System/README.md
!/02_personal-os/99_System/context/README.md
!/02_personal-os/99_System/improvement/README.md
!/02_personal-os/99_System/scripts/**
!/02_personal-os/99_System/templates/**
!/02_personal-os/extras/**
!/02_personal-os/00_Inbox/Daily/README.md
!/02_personal-os/00_Inbox/Meetings/README.md
!/02_personal-os/02_Projects/README.md
!/02_personal-os/03_Areas/People/README.md
!/02_personal-os/04_Reports/README.md
!/02_personal-os/**/.gitkeep
/02_personal-os/outputs/**
/02_personal-os/99_System/.template-files
# Your own rules, templates and scripts live in a local/ folder next to the shared ones: never tracked.
/02_personal-os/.cursor/rules/local/**
/02_personal-os/99_System/templates/local/**
/02_personal-os/99_System/scripts/local/**

# Content folders are sealed: the directories themselves are excluded, so a nested .gitignore with a `!`
# rule, a stray .gitkeep or an embedded git repo inside your notes can never re-include anything.
# Only the template markers listed right after are re-included, by exact path.
/02_personal-os/00_Inbox/**
/02_personal-os/01_Tasks/**
/02_personal-os/02_Projects/**
/02_personal-os/03_Areas/**
/02_personal-os/04_Reports/**
/02_personal-os/90_Archives/**
/02_personal-os/outputs/**
!/02_personal-os/00_Inbox/Daily/
!/02_personal-os/00_Inbox/Daily/.gitkeep
!/02_personal-os/00_Inbox/Daily/README.md
!/02_personal-os/00_Inbox/Ideas/
!/02_personal-os/00_Inbox/Ideas/.gitkeep
!/02_personal-os/00_Inbox/Meetings/
!/02_personal-os/00_Inbox/Meetings/.gitkeep
!/02_personal-os/00_Inbox/Meetings/README.md
!/02_personal-os/01_Tasks/.gitkeep
!/02_personal-os/02_Projects/.gitkeep
!/02_personal-os/02_Projects/README.md
!/02_personal-os/03_Areas/People/
!/02_personal-os/03_Areas/People/README.md
!/02_personal-os/03_Areas/People/Leaders/
!/02_personal-os/03_Areas/People/Leaders/.gitkeep
!/02_personal-os/03_Areas/People/Team/
!/02_personal-os/03_Areas/People/Team/.gitkeep
!/02_personal-os/03_Areas/Product Team/
!/02_personal-os/03_Areas/Product Team/Meetings/
!/02_personal-os/03_Areas/Product Team/Meetings/.gitkeep
!/02_personal-os/04_Reports/.gitkeep
!/02_personal-os/04_Reports/README.md
!/02_personal-os/90_Archives/Meetings/
!/02_personal-os/90_Archives/Meetings/.gitkeep
!/02_personal-os/90_Archives/Tasks/
!/02_personal-os/90_Archives/Tasks/.gitkeep
