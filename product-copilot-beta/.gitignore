# =============================================================
# WHITELIST APPROACH — everything is ignored unless listed here
# =============================================================

# Ignore everything by default
*

# Allow directory traversal (git needs this to reach nested files)
!*/

# ---- Core config files ----
!.gitignore
!.env.example
!CLAUDE.md
!README.md

# ---- Copilot folders ----
!skills/**
!policies/**
!agents/**
!knowledge/**
!reports/**
!mcp/**
!.cursor/**
!engineering/**
!onboarding/**
!prototypes/**
!.cursorignore
!.rgignore
!OWNERSHIP.md

# ---- Always ignore (even inside whitelisted folders) ----
.env
me.md
.cursor/rules/**
.cursor/debug-*.log
mcp/.cursor/mcp.json
**/node_modules/**
**/__pycache__/**
**/*.pyc
**/.DS_Store
**/*.zip
**/Icon?
**/*.local
**/package-lock.json

# Generated by onboarding/build-catalog.mjs (rebuilt by /update-product-os)
onboarding/data/**

# Clone cache only — do not use an unanchored `repos/` (that would hide
# engineering/index/repos/ manifests from git and ripgrep).
/engineering/repos/

# ---- Personal working output (never whitelist) ----
# Request-generated artifacts (HTML mocks, drafts, exports, ad-hoc analysis).
# Already excluded by the top-level `*` whitelist; listed here so agents never
# add `!product-copilot/**`. Store all such files under product-copilot/.
product-copilot/**
